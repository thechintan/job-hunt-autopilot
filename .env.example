# ==============================================================================
# Job Hunt Autopilot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values if needed:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux / macOS)
#
# NOTE: The core app runs 100% offline and locally out of the box with rules-only!
# All variables below are OPTIONAL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Kaggle API Credentials (Optional)
# ------------------------------------------------------------------------------
# Required only if you want `python -m scripts.download_data` to automatically
# fetch the Kaggle fake job postings dataset (50MB).
# Alternatively, you can place kaggle.json in ~/.kaggle/ or download manually:
# https://www.kaggle.com/datasets/shivamb/real-or-fake-fake-jobposting-prediction
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# ------------------------------------------------------------------------------
# HuggingFace Token (Optional)
# ------------------------------------------------------------------------------
# Only needed if you experience rate limits when downloading the Hinglish scam dataset.
HF_TOKEN=

# ------------------------------------------------------------------------------
# Streamlit Configuration (Optional)
# ------------------------------------------------------------------------------
# Custom port and headless mode if deploying or running in containers.
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
